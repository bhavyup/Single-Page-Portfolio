{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,script.js,styles.css,assets/**,logo/**,server/public/**,server/data/content.json}"
    }
  },
  "rewrites": [
    {
      "source": "/simple-calc",
      "destination": "https://simple-calculator-orcin-five.vercel.app/"
    },
    {
      "source": "/simple-calc/:path*",
      "destination": "https://simple-calculator-orcin-five.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}